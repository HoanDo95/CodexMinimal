{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "primarySkill",
    "followUpSkills",
    "recommendedModel",
    "recommendedEffort",
    "contextBudget",
    "safetyGate",
    "gateReason",
    "nextAction"
  ],
  "properties": {
    "classification": {
      "type": "string",
      "enum": [
        "simple",
        "scan",
        "planner",
        "idsd",
        "tdd",
        "coding",
        "bug-fix",
        "debug",
        "review",
        "refactor",
        "orchestrator"
      ]
    },
    "primarySkill": {
      "type": "string",
      "enum": [
        "none",
        "idsd-orchestrator",
        "project-init",
        "project-indexer",
        "nestjs-tdd-builder",
        "nestjs-bug-fixer",
        "nestjs-code-reviewer",
        "nestjs-refactor-guardian",
        "rust-tdd-builder",
        "rust-bug-fixer",
        "rust-code-reviewer",
        "rust-refactor-guardian",
        "repo-phase-orchestrator"
      ]
    },
    "followUpSkills": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "idsd-orchestrator",
          "project-init",
          "project-indexer",
          "nestjs-tdd-builder",
          "nestjs-bug-fixer",
          "nestjs-code-reviewer",
          "nestjs-refactor-guardian",
          "rust-tdd-builder",
          "rust-bug-fixer",
          "rust-code-reviewer",
          "rust-refactor-guardian",
          "repo-phase-orchestrator"
        ]
      }
    },
    "recommendedModel": {
      "type": "string",
      "description": "Model tier description (default or escalated), never a hardcoded model name"
    },
    "recommendedEffort": {
      "type": "string"
    },
    "contextBudget": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "safetyGate": {
      "type": "string",
      "enum": [
        "proceed",
        "ask-user",
        "blocked"
      ]
    },
    "gateReason": {
      "type": "string",
      "description": "One line naming the highest-risk action behind the gate decision"
    },
    "nextAction": {
      "type": "string"
    }
  }
}
