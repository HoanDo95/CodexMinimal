{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "currentStage",
    "intentContract",
    "architectureDecisions",
    "boundedSpecification",
    "taskBreakdown",
    "testContract",
    "agentCards",
    "decisionLedgerEntries",
    "acceptanceEvidence",
    "protectedFileOrRiskConcerns",
    "nextSkill",
    "followUpChain",
    "stopCondition",
    "reportOutline",
    "suggestedPrompt"
  ],
  "properties": {
    "classification": {
      "type": "string",
      "enum": ["idsd"]
    },
    "currentStage": {
      "type": "string",
      "enum": ["intent", "solution-challenge", "system-design", "architecture-decision", "specification", "task-breakdown", "qa-evidence", "tests", "implementation-handoff", "verification", "report"]
    },
    "intentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "businessRules", "nonGoals", "constraints", "acceptanceCriteria"],
      "properties": {
        "intent": { "type": "string" },
        "businessRules": { "type": "array", "items": { "type": "string" } },
        "nonGoals": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } }
      }
    },
    "architectureDecisions": { "type": "array", "items": { "type": "string" } },
    "solutionChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options", "selectedPath", "counterarguments", "residualRisks"],
      "properties": {
        "options": { "type": "array", "items": { "type": "string" } },
        "selectedPath": { "type": "string" },
        "counterarguments": { "type": "array", "items": { "type": "string" } },
        "residualRisks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "systemDesignGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundaries", "dataFlow", "failureModes", "compatibility", "operationalRisks"],
      "properties": {
        "boundaries": { "type": "array", "items": { "type": "string" } },
        "dataFlow": { "type": "array", "items": { "type": "string" } },
        "failureModes": { "type": "array", "items": { "type": "string" } },
        "compatibility": { "type": "array", "items": { "type": "string" } },
        "operationalRisks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "boundedSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "interfaces", "dataImpacts", "risks", "acceptanceMapping"],
      "properties": {
        "behavior": { "type": "array", "items": { "type": "string" } },
        "interfaces": { "type": "array", "items": { "type": "string" } },
        "dataImpacts": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "acceptanceMapping": { "type": "array", "items": { "type": "string" } }
      }
    },
    "taskBreakdown": { "type": "array", "items": { "type": "string" } },
    "qaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeCases", "regressionTargets", "evidenceGaps", "acceptanceVerdict"],
      "properties": {
        "edgeCases": { "type": "array", "items": { "type": "string" } },
        "regressionTargets": { "type": "array", "items": { "type": "string" } },
        "evidenceGaps": { "type": "array", "items": { "type": "string" } },
        "acceptanceVerdict": { "type": "string" }
      }
    },
    "testContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tddMode", "testPlan", "verificationAlternatives"],
      "properties": {
        "tddMode": { "type": "string", "enum": ["test-first-required", "test-plan-only", "manual-verification-acceptable", "not-applicable"] },
        "testPlan": { "type": "array", "items": { "type": "string" } },
        "verificationAlternatives": { "type": "array", "items": { "type": "string" } }
      }
    },
    "agentCards": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["planner", "architect", "solution_challenger", "system_designer", "implementer", "senior_qa", "verifier", "reviewer"]
      }
    },
    "decisionLedgerEntries": { "type": "array", "items": { "type": "string" } },
    "acceptanceEvidence": { "type": "array", "items": { "type": "string" } },
    "protectedFileOrRiskConcerns": { "type": "array", "items": { "type": "string" } },
    "nextSkill": { "type": "string" },
    "followUpChain": { "type": "array", "items": { "type": "string" } },
    "stopCondition": { "type": "string" },
    "reportOutline": { "type": "array", "items": { "type": "string" } },
    "suggestedPrompt": { "type": "string" }
  }
}
